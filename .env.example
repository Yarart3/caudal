# Configuración de Caudal. Copia este archivo como .env y rellena los valores.
# El .env es distinto en cada ordenador y NUNCA se sube a git.

# Puerto en el que se abre la app: http://localhost:8080
APP_PORT=8080

# Base de datos (PostgreSQL). Genera la contraseña con:
#   Mac:        openssl rand -hex 24
#   PowerShell: -join ((1..24) | ForEach-Object { '{0:x2}' -f (Get-Random -Max 256) })
POSTGRES_USER=caudal
POSTGRES_PASSWORD=cambia-esto
POSTGRES_DB=caudal

# Sesión: minutos sin actividad hasta que se cierra sola
SESSION_TIMEOUT_MIN=30
# Bloqueo del inicio de sesión: intentos fallidos y minutos de bloqueo
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_MIN=5

# --- Backups (Fase 1d) ---
# Contraseña de los backups: distinta de las de inicio de sesión y APUNTADA EN PAPEL.
# Si se pierde, las copias no se pueden abrir. Sin ella, la app no hace copias y lo avisa.
BACKUP_PASSWORD=
BACKUP_INTERVAL_MIN=60
BACKUP_KEEP=30
BACKUP_MAX_AGE_DAYS=7
# Nombre de volumen del pendrive (el script de arranque lo busca por este nombre)
USB_LABEL=Gerard
# Ruta de la carpeta de backups en OneDrive. Siempre entre comillas.
# Windows: ONEDRIVE_DIR="C:\Users\gerar\OneDrive - udl.cat\Proyectos\CaudalBackups"
# Mac:     ONEDRIVE_DIR="/Users/<usuario>/Library/CloudStorage/OneDrive-<organización>/Proyectos/CaudalBackups"
ONEDRIVE_DIR=""

# --- A partir de la Fase 3 (precios) ---
PRICE_REFRESH_MIN=15
PRICE_MAX_AGE_HOURS=6
